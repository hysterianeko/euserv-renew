# EUserv account credentials. Multiple accounts can be separated by spaces.
USERNAME=your_euserv_email@example.com
PASSWORD=replace_with_euserv_password

# Mailparser parsed-data download URL or ID for the renewal PIN.
MAILPARSER_DOWNLOAD_URL=https://files.mailparser.io/d/replace_me

# Self-hosted CAPTCHA gateway.
CAPTCHA_PROVIDER=challenge-gateway
CHALLENGE_GATEWAY_URL=https://challenge.cool.pp.ua
CHALLENGE_GATEWAY_KEY=replace_with_shared_gateway_key

# Optional Telegram notifications.
TG_BOT_TOKEN=replace_with_telegram_bot_token
TG_USER_ID=replace_with_telegram_user_id
TG_API_HOST=https://api.telegram.org

LOGIN_MAX_RETRY_COUNT=5
WAITING_TIME_OF_PIN=15
CHECK_CAPTCHA_SOLVER_USAGE=false
MAILPARSER_DOWNLOAD_BASE_URL=https://files.mailparser.io/d/
